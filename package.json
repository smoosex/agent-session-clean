{
  "name": "@smoose/agc",
  "version": "0.0.1",
  "description": "Agent session manager for Pi, Claude Code, Antigravity, Codex, Grok, and OpenCode",
  "type": "module",
  "bin": {
    "agc": "bin/agc.js"
  },
  "files": [
    "bin",
    "dist/npm",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/main.tsx",
    "start": "bun run bin/agc.js",
    "compile": "bun run scripts/compile.ts",
    "compile:all": "bun run scripts/compile.ts --all",
    "build:package": "bun run scripts/build-package.ts",
    "pack:check": "npm pack --dry-run",
    "prepack": "bun run build:package",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoosex/agent-session-clean.git"
  },
  "homepage": "https://github.com/smoosex/agent-session-clean",
  "bugs": {
    "url": "https://github.com/smoosex/agent-session-clean/issues"
  },
  "keywords": [
    "agent",
    "session",
    "terminal",
    "tui",
    "opentui"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentui/core": "0.5.8",
    "@opentui/solid": "0.5.8",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^5"
  }
}
